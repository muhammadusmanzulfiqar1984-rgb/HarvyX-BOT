GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-120b

NVIDIA_API_KEY=
NVIDIA_SMART_MODEL=nvidia/nemotron-3-ultra-550b-a55b

NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_SMART_MODEL=

SMART_PROVIDER=nim
# SMART_PROVIDER=pareto  # Analyst uses Cloudflare Unbiased Pareto (unbiased/pareto)

# Cloudflare Workers AI / Pareto (server-only — never NEXT_PUBLIC_*)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PARETO_MODEL=unbiased/pareto
# CLOUDFLARE_AI_TIMEOUT_MS=60000

HARVYX_API_KEY=
HARVYX_API_BASE=https://www.harvics.com

# Harvics OS ERP (delegateToErp). Must equal INTERNAL_API_KEY on the harvics.com backend.
HARVICS_API_KEY=
HARVICS_API_BASE=https://www.harvics.com

# Gmail OAuth connector (server-side only — never NEXT_PUBLIC_*)
# Create a Google Cloud OAuth 2.0 Web Application client.
# Local dev redirect URI: http://localhost:3000/api/connectors/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # Optional override; auto-detected from request URL if omitted
